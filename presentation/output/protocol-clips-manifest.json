          "  \"restored\": false,",
          "  \"upstream_original_absent\": true,",
          "  \"delivered_preview\": \"[FFR2.local-... [abbreviated]\",",
          "  \"echo_invocations\": 1",
          "}"
        ],
        "color": "#4EE0BE",
